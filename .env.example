# ---------------------------------------------------------------
# CLEO-agent environment variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the .env file – it is listed in .gitignore.
# ---------------------------------------------------------------

# Required for direct OpenAI usage: OpenAI API key
# (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Azure OpenAI configuration.
# If both AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_API_KEY are set,
# CLEO uses Azure OpenAI and treats CLEO_MODEL / --model as deployment name.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_API_VERSION=2024-02-01

# Recommended: Tavily Search API key (https://tavily.com)
# If omitted, the agent falls back to DuckDuckGo (no key needed).
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: override the default OpenAI model (default: gpt-4o)
# CLEO_MODEL=gpt-4o
